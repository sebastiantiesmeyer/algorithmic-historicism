# Copy this file to .env. Never commit the populated .env file.
OPENAI_API_KEY=

# LLM used to answer benchmark tasks.
AH_LLM_PROVIDER=openai
AH_AGENT_MODEL=

# LLM used to consolidate evaluated experiences into wiki notes.
# Leave blank to reuse AH_AGENT_MODEL.
AH_CONSOLIDATOR_MODEL=

AH_LLM_MAX_OUTPUT_TOKENS=12000
# Optional. Some reasoning models do not accept temperature.
AH_LLM_TEMPERATURE=
# Optional OpenAI-compatible endpoint.
AH_LLM_BASE_URL=
